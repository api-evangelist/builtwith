      },
      "item": [
        {
          "id": "da8fd1ab-b1ca-464d-8401-ff13248084e7",
          "name": "Lookup domain technologies (JSON)",
          "request": {
            "name": "Lookup domain technologies (JSON)",
            "description": {
              "content": "Returns the technology stack and metadata for one or more domains in JSON format. Supports up to 16 domains as a comma-separated list.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "KEY",
                  "value": "<uuid>",
                  "description": "Your BuiltWith API authentication key (UUID format)"
                },
                {
                  "disabled": false,
                  "key": "LOOKUP",
                  "value": "<string>",
                  "description": "(Required) Domain or comma-separated list of up to 16 domains to look up. Use root domains only.\n"
                },
                {
                  "disabled": false,
                  "key": "HIDETEXT",
                  "value": "<string>",
                  "description": "Set to 'yes' to exclude technology descriptions and links"
                },
                {
                  "disabled": false,
                  "key": "NOMETA",
                  "value": "<string>",
                  "description": "Set to 'yes' to skip address and company metadata"
                },
                {
                  "disabled": false,
                  "key": "NOPII",
                  "value": "<string>",
                  "description": "Set to 'yes' to remove personally identifiable information (names/emails)"
                },
                {
                  "disabled": false,
                  "key": "LIVEONLY",
                  "value": "<string>",
                  "description": "Set to 'yes' to return only currently active technologies"
                },
                {
                  "disabled": false,
                  "key": "TRUST",
                  "value": "<string>",
                  "description": "Set to 'yes' to include trust/safety data (uses additional API credits)"
                },
                {
                  "disabled": false,
                  "key": "FDRANGE",
                  "value": "<string>",
                  "description": "Filter by detection date range in YYYY-MM-DD|YYYY-MM-DD format"
                },
                {
                  "disabled": false,
                  "key": "NOATTR",
                  "value": "<string>",
                  "description": "Set to 'yes' to exclude technology attributes"
                },
                {
                  "disabled": false,
                  "key": "CATEGORIES",
                  "value": "<integer>",
                  "description": "Set to '1' to return technology category list instead of domain data"
                },
                {
                  "disabled": false,
                  "key": "VERTICALS",
                  "value": "<integer>",
                  "description": "Set to '1' to return vertical list instead of domain data"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
