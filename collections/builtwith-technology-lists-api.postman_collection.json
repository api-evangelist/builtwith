          "name": "Get technology website list (JSON)",
          "request": {
            "name": "Get technology website list (JSON)",
            "description": {
              "content": "Returns a paginated list of websites using the specified technology, with optional filters for country, spend, revenue, followers, and rank.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "KEY",
                  "value": "<uuid>"
                },
                {
                  "disabled": false,
                  "key": "TECH",
                  "value": "<string>",
                  "description": "(Required) Technology name (spaces replaced with dashes, e.g. Google-Analytics)"
                },
                {
                  "disabled": false,
                  "key": "OTHERTECHS",
                  "value": "<string>",
                  "description": "Additional technologies to filter by (comma-separated, max 16)"
                },
                {
                  "disabled": false,
                  "key": "META",
                  "value": "<string>",
                  "description": "Set to 'yes' to include metadata (names, titles, social links)"
                },
                {
                  "disabled": false,
                  "key": "COUNTRY",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code(s), comma-separated"
                },
                {
                  "disabled": false,
                  "key": "OFFSET",
                  "value": "<string>",
                  "description": "Pagination anchor from the previous response's NextOffset field"
                },
                {
                  "disabled": false,
                  "key": "SINCE",
                  "value": "<string>",
                  "description": "Filter for recent detections only ('30 Days Ago' or ISO date, incompatible with ALL)"
                },
                {
                  "disabled": false,
                  "key": "ALL",
                  "value": "<string>",
                  "description": "Set to 'yes' to include historical data (incompatible with SINCE)"
                },
                {
                  "disabled": false,
                  "key": "SPEND",
                  "value": "<string>",
                  "description": "Filter by monthly tech spend using 'amount|operator' (e.g. 100|GT)"
                },
                {
                  "disabled": false,
                  "key": "REVENUE",
                  "value": "<string>",
                  "description": "Filter by eCommerce revenue using 'amount|operator'"
                },
                {
                  "disabled": false,
                  "key": "FOLLOWERS",
                  "value": "<string>",
                  "description": "Filter by social follower count using 'count|operator'"
                },
                {
                  "disabled": false,
                  "key": "PAGERANK",
                  "value": "<string>",
                  "description": "Filter by traffic rank using 'rank|operator'"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
